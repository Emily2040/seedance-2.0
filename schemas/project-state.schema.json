{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Emily2040/seedance-2.0/schemas/project-state.schema.json",
  "title": "Seedance Sequence Project State",
  "description": "Structural and record-local validation only. Graph-wide lineage semantics require project_state_check.py and continuity_chain_check.py.",
  "$comment": "JSON Schema cannot enforce clip-id uniqueness, parent existence, self-parent rejection, parent-before-child ordering, cycle freedom, or parent status/endpoint usability. Run both semantic validators.",
  "type": "object",
  "required": [
    "schema_version",
    "state_revision",
    "project_id",
    "project_mode",
    "surface",
    "clip_budget_sec",
    "prompt_budget",
    "story",
    "world_bible",
    "reference_registry",
    "scenes",
    "beats",
    "clips",
    "take_history",
    "current_clip_id",
    "canon_revision",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "state_revision": {"type": "integer", "minimum": 1},
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "project_mode": {"enum": ["standalone_clip", "sequence_project"]},
    "surface": {"type": "object"},
    "clip_budget_sec": {"type": ["number", "null"]},
    "prompt_budget": {"type": ["integer", "null"]},
    "story": {"$ref": "#/$defs/story"},
    "world_bible": {"type": "object"},
    "reference_registry": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "scenes": {"type": "array", "items": {"$ref": "#/$defs/scene"}},
    "beats": {"type": "array", "items": {"$ref": "#/$defs/beat"}},
    "clips": {"type": "array", "items": {"$ref": "#/$defs/clip"}},
    "take_history": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/take_history_item"}
    },
    "current_clip_id": {"type": "string"},
    "canon_revision": {"type": "integer", "minimum": 1},
    "updated_at": {"type": "string"}
  },
  "$defs": {
    "take_history_item": {
      "type": "object",
      "required": ["take_id", "clip_id", "verdict"],
      "additionalProperties": false,
      "properties": {
        "take_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "clip_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "verdict": {
          "enum": ["accept", "accept_with_deviation", "repair", "reject"]
        },
        "evidence": {"type": "string", "maxLength": 4096}
      }
    },
    "story": {
      "type": "object",
      "required": ["logline", "story_promise", "objective", "initial_condition", "final_outcome", "target_duration_sec", "tone", "medium"],
      "properties": {
        "logline": {"type": "string"},
        "story_promise": {"type": "string"},
        "objective": {"type": "string"},
        "initial_condition": {"type": "string"},
        "final_outcome": {"type": "string"},
        "target_duration_sec": {"type": ["number", "null"]},
        "tone": {"type": "string"},
        "medium": {"type": "string"}
      }
    },
    "reference": {
      "type": "object",
      "required": ["tag", "role", "preserve_exact_tag"],
      "properties": {
        "tag": {"type": "string", "minLength": 1},
        "role": {"type": "string"},
        "preserve_exact_tag": {"const": true}
      }
    },
    "scene": {
      "type": "object",
      "required": ["scene_id", "scene_index", "narrative_function", "arc_position", "location", "time_of_day", "anchor_source", "max_chain_depth", "audio_plan", "assigned_clip_ids", "transition_out", "status"],
      "properties": {
        "scene_id": {"type": "string"},
        "scene_index": {"type": "integer", "minimum": 1},
        "narrative_function": {"type": "string"},
        "arc_position": {"enum": ["open", "rising", "turn", "climax", "release"]},
        "location": {"type": "string"},
        "time_of_day": {"type": "string"},
        "anchor_source": {"type": "array", "items": {"type": "string"}},
        "max_chain_depth": {"type": "integer", "minimum": 0, "maximum": 3},
        "audio_plan": {"type": "string"},
        "assigned_clip_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "transition_out": {"type": "string"},
        "status": {"enum": ["planned", "current", "completed", "omitted", "replaced"]}
      }
    },
    "beat": {
      "type": "object",
      "required": ["beat_id", "description", "narrative_function", "status", "assigned_clip_id", "dependencies"],
      "properties": {
        "beat_id": {"type": "string"},
        "description": {"type": "string"},
        "narrative_function": {"type": "string"},
        "status": {"enum": ["planned", "current", "completed", "omitted", "replaced"]},
        "assigned_clip_id": {"type": ["string", "null"]},
        "dependencies": {"type": "array", "items": {"type": "string"}}
      }
    },
    "clip": {
      "type": "object",
      "required": [
        "clip_id",
        "scene_id",
        "sequence_index",
        "prompt_version",
        "generation_mode",
        "status",
        "narrative_job",
        "felt_intent",
        "already_happened",
        "this_clip_only",
        "reserved_for_later",
        "planned_start_state",
        "planned_end_state",
        "observed_start_state",
        "observed_end_state",
        "continuity_locks",
        "allowed_changes",
        "continuity_breaks",
        "accepted_deviations",
        "transition_in",
        "transition_out",
        "open_motion_vectors",
        "handoff_requirements",
        "extension_depth"
      ],
      "properties": {
        "clip_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"},
        "parent_clip_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256, "pattern": "\\S"},
        "scene_id": {"type": "string"},
        "sequence_index": {"type": "integer", "minimum": 1},
        "prompt_version": {"type": "string"},
        "generation_mode": {"type": "string"},
        "source_clip_tag": {"type": ["string", "null"]},
        "status": {"enum": ["planned", "ready", "generated", "reviewed", "accepted", "accepted_with_deviation", "repair", "rejected"]},
        "narrative_job": {"type": "string"},
        "felt_intent": {"type": "string", "minLength": 1, "pattern": "^(?=.*[^\\s\\u00ad\\u034f\\u0600-\\u0605\\u061c\\u06dd\\u070f\\u08e2\\u115f-\\u1160\\u17b4-\\u17b5\\u180b-\\u180f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\u2066-\\u206f\\u2800\\u3164\\ufe00-\\ufe0f\\ufeff\\uffa0\\ufff0-\\ufffb\ud804\udcbd\ud804\udccd\ud80d\udc30-\ud80d\udc38\ud82f\udca0-\ud82f\udca3\ud834\udd73-\ud834\udd7a\udb40\udc00-\udb43\udfff])[^\\r\\n\\u000b\\u000c\\u001c\\u001d\\u001e\\u0085\\u2028\\u2029]+$"},
        "directors_read_lane": {"enum": ["narrative", "non_narrative"]},
        "authoring_state": {"$ref": "#/$defs/authoring_state"},
        "contract_authoring_state_snapshots": {
          "type": "array",
          "items": {"$ref": "#/$defs/authoring_state_provenance"},
          "uniqueItems": true
        },
        "already_happened": {"type": "array", "items": {"type": "string"}},
        "this_clip_only": {"type": "array", "items": {"type": "string"}},
        "reserved_for_later": {"type": "array", "items": {"type": "string"}},
        "planned_start_state": {"type": "object"},
        "planned_end_state": {"type": "object"},
        "observed_start_state": {"type": ["object", "null"]},
        "observed_end_state": {"type": ["object", "null"]},
        "continuity_locks": {"type": "array"},
        "allowed_changes": {"type": "array"},
        "continuity_breaks": {"type": "array"},
        "accepted_deviations": {"type": "array"},
        "transition_in": {"type": "string"},
        "transition_out": {"type": "string"},
        "open_motion_vectors": {"type": "array"},
        "handoff_requirements": {"type": "array"},
        "extension_depth": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {
          "if": {
            "properties": {"sequence_index": {"const": 1}},
            "required": ["sequence_index"]
          },
          "then": {
            "properties": {"parent_clip_id": {"type": "null"}}
          },
          "else": {
            "required": ["parent_clip_id"],
            "properties": {
              "parent_clip_id": {"type": "string", "minLength": 1, "pattern": "\\S"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {"enum": ["accepted", "accepted_with_deviation"]}
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "observed_end_state": {"type": "object", "minProperties": 1}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "rejected"}},
            "required": ["status"]
          },
          "then": {
            "properties": {"observed_end_state": {"type": "null"}}
          }
        },
        {
          "if": {
            "anyOf": [
              {"required": ["authoring_state"]},
              {"required": ["contract_authoring_state_snapshots"]}
            ]
          },
          "then": {
            "required": ["directors_read_lane", "authoring_state"]
          }
        },
        {
          "if": {
            "required": ["directors_read_lane"],
            "properties": {"directors_read_lane": {"const": "narrative"}}
          },
          "then": {
            "required": ["authoring_state"],
            "properties": {"authoring_state": {"$ref": "#/$defs/narrative_authoring_state"}}
          }
        },
        {
          "if": {
            "required": ["directors_read_lane"],
            "properties": {"directors_read_lane": {"const": "non_narrative"}}
          },
          "then": {
            "required": ["authoring_state"],
            "properties": {"authoring_state": {"$ref": "#/$defs/non_narrative_authoring_state"}}
          }
        }
      ]
    },
    "authoring_state_provenance": {
      "type": "object",
      "required": [
        "project_id",
        "clip_id",
        "canon_revision",
        "state_revision",
        "authoring_state_sha256"
      ],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "clip_id": {"type": "string", "minLength": 1},
        "canon_revision": {"type": "integer", "minimum": 1},
        "state_revision": {"type": "integer", "minimum": 1},
        "authoring_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "authoring_state": {
      "oneOf": [
        {"$ref": "#/$defs/narrative_authoring_state"},
        {"$ref": "#/$defs/non_narrative_authoring_state"}
      ]
    },
    "narrative_authoring_state": {
      "type": "object",
      "description": "Complete canonical narrative Director's Read plus explicit value endpoints and auditable prompt carriers.",
      "required": [
        "dramatic_function",
        "turn",
        "pov",
        "power_shift",
        "hidden_want_objective",
        "obstacle_tactic",
        "subtext_contradiction",
        "visible_suppressed_behavior",
        "non_transferable_detail",
        "non_transferable_detail_provenance",
        "non_transferable_detail_source",
        "stock_solution_refused",
        "value_before",
        "value_after",
        "prompt_carriers"
      ],
      "properties": {
        "dramatic_function": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n\\u000b\\u000c\\u001c\\u001d\\u001e\\u0085\\u2028\\u2029]+$"},
        "turn": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n\\u000b\\u000c\\u001c\\u001d\\u001e\\u0085\\u2028\\u2029]+$"},
        "pov": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n\\u000b\\u000c\\u001c\\u001d\\u001e\\u0085\\u2028\\u2029]+$"},
        "power_shift": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n\\u000b\\u000c\\u001c\\u001d\\u001e\\u0085\\u2028\\u2029]+$"},
        "hidden_want_objective": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n\\u000b\\u000c\\u001c\\u001d\\u001e\\u0085\\u2028\\u2029]+$"},
        "obstacle_tactic": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n\\u000b\\u000c\\u001c\\u001d\\u001e\\u0085\\u2028\\u2029]+$"},
        "subtext_contradiction": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n\\u000b\\u000c\\u001c\\u001d\\u001e\\u0085\\u2028\\u2029]+$"},
        "visible_suppressed_behavior": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n\\u000b\\u000c\\u001c\\u001d\\u001e\\u0085\\u2028\\u2029]+$"},
        "non_transferable_detail": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n\\u000b\\u000c\\u001c\\u001d\\u001e\\u0085\\u2028\\u2029]+$"},
        "non_transferable_detail_provenance": {"enum": ["source_bound", "authored_choice"]},
        "non_transferable_detail_source": {"type": ["string", "null"]},
        "stock_solution_refused": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n\\u000b\\u000c\\u001c\\u001d\\u001e\\u0085\\u2028\\u2029]+$"},
        "value_before": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n\\u000b\\u000c\\u001c\\u001d\\u001e\\u0085\\u2028\\u2029]+$"},
        "value_after": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n\\u000b\\u000c\\u001c\\u001d\\u001e\\u0085\\u2028\\u2029]+$"},
        "prompt_carriers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n\\u000b\\u000c\\u001c\\u001d\\u001e\\u0085\\u2028\\u2029]+$"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"non_transferable_detail_provenance": {"const": "source_bound"}}},
          "then": {
            "properties": {
              "non_transferable_detail_source": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?:@[A-Za-z][A-Za-z0-9]*(?:[ \\t]+[0-9]+)?|\\[[^\\]\\r\\n\\u000b\\u000c\\u001c\\u001d\\u001e\\u0085\\u2028\\u2029]+\\]|https?://\\S+|(?:file|ref|evidence):\\S+)$"
              }
            }
          }
        },
        {
          "if": {"properties": {"non_transferable_detail_provenance": {"const": "authored_choice"}}},
          "then": {"properties": {"non_transferable_detail_source": {"const": null}}}
        }
      ],
      "additionalProperties": false
    },
    "non_narrative_authoring_state": {
      "type": "object",
      "description": "Complete canonical two-line non-narrative Director's Read.",
      "required": ["utility_intent", "non_narrative_refusal"],
      "properties": {
        "utility_intent": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n\\u000b\\u000c\\u001c\\u001d\\u001e\\u0085\\u2028\\u2029]+$"},
        "non_narrative_refusal": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n\\u000b\\u000c\\u001c\\u001d\\u001e\\u0085\\u2028\\u2029]+$"}
      },
      "additionalProperties": false
    }
  }
}
